{
  "name": "@glossa/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Glossa's JS runtime: a minimal MessageFormat 2 interpreter over precompiled messages, built on Intl only.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./idb": {
      "types": "./dist/idb.d.ts",
      "import": "./dist/idb.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "@glossa/runtime",
      "path": "dist/index.js",
      "limit": "4 KB"
    }
  ],
  "devDependencies": {
    "@glossa/messageformat": "workspace:*",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "6.2.5",
    "size-limit": "^11.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT",
  "author": "Felix Geelhaar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixgeelhaar/glossa.git",
    "directory": "runtimes/js/runtime"
  },
  "engines": {
    "node": ">=22"
  }
}

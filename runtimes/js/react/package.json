{
  "name": "@glossa/react",
  "version": "0.0.0",
  "private": true,
  "description": "Glossa for React 18.3+ and 19: a provider, useGlossa()/useMessages() hooks and <T>, SSR- and hydration-safe through useSyncExternalStore, on @glossa/runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "@glossa/react, own code (react and @glossa/runtime excluded)",
      "path": "dist/index.js",
      "ignore": ["react", "@glossa/runtime"],
      "limit": "1.5 KB"
    },
    {
      "name": "@glossa/react with @glossa/runtime (react excluded)",
      "path": "dist/index.js",
      "ignore": ["react"],
      "limit": "8 KB"
    }
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@glossa/elements": "workspace:*",
    "@glossa/runtime": "workspace:*"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "11.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "25.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "size-limit": "11.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "license": "MIT",
  "author": "Felix Geelhaar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixgeelhaar/glossa.git",
    "directory": "runtimes/js/react"
  },
  "engines": {
    "node": ">=22"
  }
}

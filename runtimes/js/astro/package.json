{
  "name": "@glossa/astro",
  "version": "0.0.0",
  "private": true,
  "description": "Glossa for Astro 5: static pages rendered with the release at build time, islands and <glossa-*> elements sharing one runtime with the same release, and locale routing helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "@glossa/astro/client, the islands' page runtime (@glossa/runtime excluded)",
      "path": "dist/client.js",
      "ignore": [
        "@glossa/runtime",
        "virtual:glossa/config"
      ],
      "limit": "0.75 KB"
    }
  ],
  "peerDependencies": {
    "astro": "^6.4.0 || ^7.0.0"
  },
  "dependencies": {
    "@glossa/elements": "workspace:*",
    "@glossa/runtime": "workspace:*",
    "@glossa/unplugin": "workspace:*",
    "@glossa/vue": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/vue": "7.0.3",
    "@size-limit/preset-small-lib": "11.2.0",
    "@types/node": "22.19.19",
    "astro": "7.3.3",
    "size-limit": "11.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "vue": "3.5.43"
  },
  "license": "MIT",
  "author": "Felix Geelhaar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixgeelhaar/glossa.git",
    "directory": "runtimes/js/astro"
  },
  "engines": {
    "node": ">=22"
  }
}

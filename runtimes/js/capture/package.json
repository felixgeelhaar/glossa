{
  "name": "@glossa/capture",
  "version": "0.0.0",
  "private": true,
  "description": "Glossa's capture mode (RFC 0004 §3.1): an onRender hook that marks t() strings with invisible markers, and the capture script that turns marked text, attributes and component hosts into regions for glossa capture. Loaded only in capture and editor sessions, never by applications.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "@glossa/capture, the whole session (@glossa/runtime is types only)",
      "path": "dist/index.js",
      "limit": "3 KB"
    }
  ],
  "peerDependencies": {
    "@glossa/runtime": "workspace:*"
  },
  "devDependencies": {
    "@glossa/elements": "workspace:*",
    "@glossa/react": "workspace:*",
    "@glossa/runtime": "workspace:*",
    "@glossa/vue": "workspace:*",
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "11.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "jsdom": "25.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "size-limit": "11.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "vue": "3.5.43"
  },
  "license": "MIT",
  "author": "Felix Geelhaar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixgeelhaar/glossa.git",
    "directory": "runtimes/js/capture"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glossa.dev/schemas/manifest/v1.json",
  "title": "Glossa release manifest v1 (runtimes/SPEC.md §1.1)",
  "type": "object",
  "required": ["schema", "project", "environment", "release", "sourceLocale", "locales", "fallback", "artifacts"],
  "properties": {
    "schema": { "const": "glossa.manifest/v1" },
    "project": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "release": {
      "type": "object",
      "required": ["id", "version", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "sourceLocale": { "$ref": "#/$defs/locale" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "direction"],
        "properties": {
          "code": { "$ref": "#/$defs/locale" },
          "direction": { "enum": ["ltr", "rtl"] }
        }
      }
    },
    "fallback": {
      "type": "object",
      "propertyNames": { "anyOf": [{ "const": "*" }, { "$ref": "#/$defs/locale" }] },
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/locale" } }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["default"],
        "additionalProperties": {
          "type": "object",
          "required": ["sha256", "size"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keyId", "alg", "sig"],
        "properties": {
          "keyId": { "type": "string" },
          "alg": { "const": "Ed25519" },
          "sig": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
        }
      }
    }
  },
  "$defs": {
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$", "maxLength": 35 }
  }
}

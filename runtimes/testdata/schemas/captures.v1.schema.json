{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glossa.dev/schemas/captures/v1.json",
  "title": "Glossa captures v1: the manifest of one capture upload (RFC 0004 §3.1–§3.3)",
  "description": "Written by `glossa capture` and uploaded with the build, one multipart part per distinct image. Each capture is one (route, viewport, locale): a page image and the regions where messages were rendered on it. Boxes are CSS pixels relative to the top-left of the full page; the image is those pixels times viewport.deviceScaleFactor. The server validates and re-encodes every image, so image.sha256 names the uploaded part, not the stored object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "application", "commit", "branch", "tool", "captures"],
  "properties": {
    "schema": { "const": "glossa.captures/v1" },
    "application": { "$ref": "https://glossa.dev/schemas/usages/v1.json#/properties/application" },
    "commit": { "$ref": "https://glossa.dev/schemas/usages/v1.json#/properties/commit" },
    "branch": { "$ref": "https://glossa.dev/schemas/usages/v1.json#/properties/branch" },
    "tool": { "$ref": "https://glossa.dev/schemas/usages/v1.json#/properties/tool" },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capture" }
    }
  },
  "$defs": {
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "url", "viewport", "locale", "image", "renders", "regions"],
      "properties": {
        "route": {
          "description": "The route pattern from the capture plan (/checkout/[step]), matching usages' route.",
          "$ref": "https://glossa.dev/schemas/usages/v1.json#/$defs/usage/properties/route"
        },
        "url": {
          "description": "The concrete URL navigated to. Informational: Glossa never fetches it.",
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https?://[^\\s]+$"
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "deviceScaleFactor": { "description": "Defaults to 1.", "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
          }
        },
        "locale": {
          "description": "The locale the page was rendered in (BCP 47).",
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
          "maxLength": 35
        },
        "image": {
          "description": "The full-page PNG.",
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "width", "height"],
          "properties": {
            "sha256": { "description": "Lowercase hex SHA-256 of the uploaded PNG bytes; names its multipart part.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "renders": {
          "description": "The session's render log: what each marker index rendered. Every region index refers to one entry.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "key", "locale"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "key": { "$ref": "https://glossa.dev/schemas/usages/v1.json#/$defs/usage/properties/key" },
              "locale": { "description": "The locale the message resolved from.", "$ref": "#/$defs/capture/properties/locale" }
            }
          }
        },
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/region" }
        }
      }
    },
    "region": {
      "description": "Where a rendered message is on the page. A component-rendered message is found by its host element's data-glossa-id (key); a t() string by its invisible marker (index into renders).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "box", "visible"],
      "oneOf": [
        { "required": ["key"], "not": { "required": ["index"] } },
        { "required": ["index"], "not": { "required": ["key"] } }
      ],
      "properties": {
        "key": { "$ref": "https://glossa.dev/schemas/usages/v1.json#/$defs/usage/properties/key" },
        "index": { "type": "integer", "minimum": 0 },
        "kind": {
          "description": "element: the host element's box. text: a marked text range. attribute: the box of the element whose attribute holds the message.",
          "enum": ["element", "text", "attribute"]
        },
        "attribute": {
          "description": "For kind attribute: the attribute's name (placeholder, title, aria-label).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "box": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          }
        },
        "visible": { "description": "false when the message rendered zero-size or off-screen, so the gap shows.", "type": "boolean" }
      },
      "if": { "properties": { "kind": { "const": "attribute" } } },
      "then": { "required": ["attribute"] },
      "else": { "not": { "required": ["attribute"] } }
    }
  }
}
